generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Admin {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  email      String    @unique @db.VarChar(100)
  username   String    @unique @db.VarChar(50)
  phone      String?   @db.VarChar(15)
  password   String    @db.VarChar(255)
  role       AdminRole @default(editor)
  createdAt  DateTime  @default(now()) @map("created_at")
  profilePic String?   @map("profile_pic") @db.VarChar(255)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at")

  @@map("admins")
}

model Blog {
  id                Int            @id @default(autoincrement())
  title             String         @db.VarChar(500)
  seoSlug           String         @unique @map("seo_slug") @db.VarChar(500)
  status            BlogStatus
  views             Int?           @default(0)
  createdAt         DateTime       @default(now()) @map("created_at")
  content           String
  author            String         @db.VarChar(255)
  featuredImage     String         @map("featured_image")
  tags              String
  categoryId        Int            @map("category_id")
  downloadLink      String?        @map("download_link")
  contentType       String?        @map("content_type") @db.Text
  faqSchema         String?        @map("faq_schema") @db.Text
  isAiGenerated     Boolean        @default(false) @map("is_ai_generated")
  lsiKeywords       String?        @map("lsi_keywords") @db.Text
  metaDescription   String?        @map("meta_description") @db.VarChar(1000)
  metaTitle         String?        @map("meta_title") @db.VarChar(500)
  personaType       String?        @map("persona_type") @db.VarChar(255)
  primaryKeyword    String?        @map("primary_keyword") @db.VarChar(255)
  searchIntent      String?        @map("search_intent") @db.VarChar(255)
  ctaText           String?        @map("cta_text") @db.VarChar(500)
  customPersona     String?        @map("custom_persona") @db.Text
  emojiUsage        String?        @map("emoji_usage") @db.VarChar(50)
  humanizationLevel Int?           @map("humanization_level")
  pov               String?        @db.VarChar(255)
  secondaryKeywords String?        @map("secondary_keywords") @db.Text
  style             String?        @db.VarChar(255)
  targetAudience    String?        @map("target_audience") @db.VarChar(1000)
  tone              String?        @db.VarChar(255)
  categories        BlogCategory[]
  comments          Comment[]
  seoMeta           SeoMeta[]
  savedBy           SavedArticle[]
  recentViews       RecentBlog[]

  @@index([status, createdAt])
  @@index([isAiGenerated])
  @@map("blogs")
}

model BlogCategory {
  blogId     Int      @map("blog_id")
  categoryId Int      @map("category_id")
  blog       Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)

  @@id([blogId, categoryId])
  @@map("blog_categories")
}

model Category {
  categoryId  Int             @id @default(autoincrement()) @map("category_id")
  name        String          @unique @db.VarChar(255)
  description String?
  status      CategoryStatus? @default(active)
  blogs       BlogCategory[]

  @@map("categories")
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  blog      Blog     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Media {
  id         Int      @id @default(autoincrement())
  fileName   String   @map("file_name") @db.VarChar(255)
  filePath   String   @map("file_path") @db.VarChar(255)
  uploadedBy Int      @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  user       User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("media")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  used      Int?      @default(0)
  createdAt DateTime? @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model SeoMeta {
  id             Int         @id @default(autoincrement())
  postId         Int         @map("post_id")
  seoTitle       String?     @map("seo_title") @db.VarChar(255)
  seoDescription String?     @map("seo_description")
  seoKeywords    String?     @map("seo_keywords")
  seoSlug        String?     @map("seo_slug") @db.VarChar(255)
  canonicalUrl   String?     @map("canonical_url") @db.VarChar(255)
  metaRobots     MetaRobots? @default(index_follow) @map("meta_robots")
  ogTitle        String?     @map("og_title") @db.VarChar(255)
  ogDescription  String?     @map("og_description")
  ogImage        String?     @map("og_image") @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at")
  blog           Blog        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("seo_meta")
}

model Signal {
  id            Int      @id @default(autoincrement())
  uuid          String   @db.VarChar(32)
  title         String   @db.VarChar(255)
  description   String   @db.Text
  filePath      String   @map("file_path") @db.VarChar(500)
  mime          String   @db.VarChar(100)
  sizeBytes     Int      @map("size_bytes")
  createdAt     DateTime @default(now()) @map("created_at")
  
  // New fields for extended metadata
  platform      String?   @db.VarChar(50)
  strategy      String?   @db.VarChar(50)
  version       String?   @db.VarChar(20)
  winRate       Decimal?  @db.Decimal(5, 2)
  profitFactor  Decimal?  @db.Decimal(5, 2)
  maxDrawdown   Decimal?  @db.Decimal(5, 2)
  rating        Decimal?  @db.Decimal(3, 2)
  downloadCount Int?      @default(0) @map("download_count")
  isPremium     Boolean?  @default(false) @map("is_premium")
  price         Decimal?  @db.Decimal(10, 2)
  features      String?   @db.Text
  requirements  String?   @db.Text
  compatibility String?   @db.Text

  @@index([createdAt], map: "created_at_idx")
  @@map("signals")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique @db.VarChar(100)
  password      String         @db.VarChar(255)
  role          UserRole       @default(viewer)
  createdAt     DateTime       @default(now()) @map("created_at")
  phone         String?        @db.VarChar(20)
  name          String?        @db.VarChar(255)
  countryCode   String?        @default("+91") @map("country_code") @db.VarChar(10)
  country       String?        @default("IN") @db.VarChar(50)
  media         Media[]
  downloads     UserDownload[]
  savedArticles SavedArticle[]
  recentBlogs   RecentBlog[]

  @@map("users")
}

model UserDownload {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  blogId    Int?     @map("blog_id")
  signalId  Int?     @map("signal_id")
  title     String   @db.VarChar(500)
  type      String   @db.VarChar(50)
  fileSize  String?  @map("file_size") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_downloads")
}

model SavedArticle {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  blogId    Int      @map("blog_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId])
  @@index([userId])
  @@map("saved_articles")
}

model RecentBlog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  blogId    Int      @map("blog_id")
  visitedAt DateTime @default(now()) @map("visited_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId])
  @@index([userId])
  @@index([visitedAt])
  @@map("recent_blogs")
}

model SeoTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  type      String   @db.VarChar(50)
  template  String
  variables String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seo_templates")
}

model SeoAutomation {
  id          Int       @id @default(autoincrement())
  taskType    String    @db.VarChar(50)
  status      String    @default("pending") @db.VarChar(20)
  input       String?
  output      String?
  error       String?
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  blogId      Int?      @map("blog_id")

  @@index([blogId], map: "blog_id_idx")
  @@index([status], map: "status_idx")
  @@map("seo_automations")
}

model IndexingLog {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(500)
  service   String   @db.VarChar(50)
  action    String   @db.VarChar(50)
  status    String   @db.VarChar(20)
  response  String?
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  blogId    Int?     @map("blog_id")

  @@index([blogId], map: "indexing_blog_id_idx")
  @@index([service, status], map: "service_status_idx")
  @@map("indexing_logs")
}

model NewsletterSubscription {
  id               Int       @id @default(autoincrement())
  email            String    @unique @db.VarChar(255)
  status           String    @default("pending") @db.VarChar(20)
  confirmToken     String?   @unique @map("confirm_token") @db.VarChar(255)
  unsubscribeToken String?   @unique @map("unsubscribe_token") @db.VarChar(255)
  subscribedAt     DateTime? @map("subscribed_at")
  confirmedAt      DateTime? @map("confirmed_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  lastEmailSentAt  DateTime? @map("last_email_sent_at")
  bounceCount      Int       @default(0) @map("bounce_count")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([status], map: "subscription_status_idx")
  @@map("newsletter_subscriptions")
}

model EmailLog {
  id          Int       @id @default(autoincrement())
  recipient   String    @db.VarChar(255)
  subject     String    @db.VarChar(500)
  templateKey String?   @map("template_key") @db.VarChar(100)
  status      String    @db.VarChar(20)
  messageId   String?   @map("message_id") @db.VarChar(255)
  error       String?
  metadata    String?
  sentAt      DateTime? @map("sent_at")
  openedAt    DateTime? @map("opened_at")
  clickedAt   DateTime? @map("clicked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([recipient], map: "email_recipient_idx")
  @@index([status], map: "email_status_idx")
  @@map("email_logs")
}

enum AdminRole {
  admin
  editor
}

enum BlogStatus {
  published
  draft
}

enum CategoryStatus {
  active
  inactive
}

enum MetaRobots {
  index_follow     @map("index, follow")
  noindex_follow   @map("noindex, follow")
  index_nofollow   @map("index, nofollow")
  noindex_nofollow @map("noindex, nofollow")
}

enum UserRole {
  admin
  editor
  viewer
}
